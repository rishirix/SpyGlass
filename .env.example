# Copy this file to .env and edit. NEVER commit .env.
#
# MODE: "demo" = local moto emulator (simulated AWS, no account needed)
#       "live" = real AWS (uses your credentials)
SPYGLASS_MODE=demo

# Region to assess (live mode). Demo mode uses us-east-1.
AWS_DEFAULT_REGION=us-east-1

# Optional: named profile from ~/.aws/credentials (live mode)
# AWS_PROFILE=

# Where the local moto emulator listens (demo mode)
MOTO_ENDPOINT=http://127.0.0.1:5001

# Security policy threshold (days) for access key age
ACCESS_KEY_MAX_AGE_DAYS=90

# Flask
FLASK_SECRET_KEY=change-me-to-a-long-random-string
