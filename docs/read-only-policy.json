{
  "Version": "2012-10-17",
  "Statement": [{
    "Effect": "Allow",
    "Action": [
      "sts:GetCallerIdentity",
      "s3:ListAllMyBuckets", "s3:GetBucketAcl", "s3:GetBucketPolicyStatus",
      "s3:GetBucketPublicAccessBlock", "s3:GetEncryptionConfiguration",
      "s3:GetBucketVersioning", "s3:GetBucketLogging",
      "iam:ListUsers", "iam:ListPolicies", "iam:GetPolicy", "iam:GetPolicyVersion",
      "iam:ListMFADevices", "iam:ListAttachedUserPolicies", "iam:ListAccessKeys",
      "iam:GetAccountSummary",
      "ec2:DescribeInstances", "ec2:DescribeSecurityGroups", "ec2:DescribeVolumes",
      "cloudtrail:DescribeTrails", "cloudtrail:GetTrailStatus"
    ],
    "Resource": "*"
  }]
}
